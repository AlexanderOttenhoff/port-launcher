<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mod downloads (Thunderstore). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Handhelds and TV-style devices: controller first, touch optional. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PortLauncher">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launch target for frontends (ES-DE, Argosy, Daijisho): ACTION_VIEW with the ROM as a content:// URI. -->
        <activity
            android:name=".LaunchActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- The in-game menu's Reset: relaunches the game once its ":game" process has ended (host/RelaunchActivity). -->
        <activity
            android:name=".host.RelaunchActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- One running game per ":game" process; the process ends when the game exits (MODULE_SPEC §4). -->
        <activity
            android:name=".host.Sdl2HostActivity"
            android:process=":game"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:enableOnBackInvokedCallback="false"
            android:preferMinimalPostProcessing="true" />
    </application>
</manifest>
