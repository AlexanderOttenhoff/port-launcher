From b34fb681aff931d64902fb4f15e5c26c9c76acd8 Mon Sep 17 00:00:00 2001
From: Alexander Ottenhoff <AlexanderOttenhoff@users.noreply.github.com>
Date: Wed, 11 Nov 2026 12:56:31 +1100
Subject: [PATCH 1/3] CMake: SDL2 include directories on Android too

---
 recompinput/CMakeLists.txt | 2 +-
 recompui/CMakeLists.txt    | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/recompinput/CMakeLists.txt b/recompinput/CMakeLists.txt
index 899372b..04da5c7 100644
--- a/recompinput/CMakeLists.txt
+++ b/recompinput/CMakeLists.txt
@@ -42,7 +42,7 @@ target_include_directories(recompinput PRIVATE
 
 if (WIN32)
     target_include_directories(recompinput PRIVATE ${sdl2_SOURCE_DIR}/include)
-elseif (APPLE OR CMAKE_SYSTEM_NAME MATCHES "Linux")
+elseif (APPLE OR ANDROID OR CMAKE_SYSTEM_NAME MATCHES "Linux")
     target_include_directories(recompinput PRIVATE ${SDL2_INCLUDE_DIRS})
 endif()
 
diff --git a/recompui/CMakeLists.txt b/recompui/CMakeLists.txt
index 4dce8e0..15bd9e3 100644
--- a/recompui/CMakeLists.txt
+++ b/recompui/CMakeLists.txt
@@ -106,7 +106,7 @@ target_include_directories(recompui PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include
 
 if (WIN32)
     target_include_directories(recompui PRIVATE ${sdl2_SOURCE_DIR}/include)
-elseif (APPLE OR CMAKE_SYSTEM_NAME MATCHES "Linux")
+elseif (APPLE OR ANDROID OR CMAKE_SYSTEM_NAME MATCHES "Linux")
     target_include_directories(recompui PRIVATE ${SDL2_INCLUDE_DIRS})
 endif()
 
-- 
