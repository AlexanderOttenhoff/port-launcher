From d63d715c5bf1db6a1545e5ee80c43cb0eac22c4b Mon Sep 17 00:00:00 2001
From: Alexander Ottenhoff <AlexanderOttenhoff@users.noreply.github.com>
Date: Wed, 11 Nov 2026 19:38:24 +1100
Subject: [PATCH] Android build and direct start (--rom, --skip-launcher,
 --game-mode)

---
 CMakeLists.txt                   |  26 +++++-
 src/android/nfd_android_stub.cpp | 147 +++++++++++++++++++++++++++++++
 src/main.cpp                     |  30 ++++++-
 3 files changed, 199 insertions(+), 4 deletions(-)
 create mode 100644 src/android/nfd_android_stub.cpp

diff --git a/CMakeLists.txt b/CMakeLists.txt
index c33980e..3dc1c87 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -68,6 +68,16 @@ if (UNIX AND NOT APPLE)
     set(NFD_PORTAL ON CACHE BOOL "Use xdg-desktop-portal instead of GTK")
 endif()
 
+# Android: find SDL2 before the subprojects (they read SDL2_INCLUDE_DIRS) and give RT64/RecompFrontend a stub nfd
+# target (no native file dialogs; the ROM comes from the launcher).
+if (ANDROID)
+    find_package(SDL2 REQUIRED)
+    if (NOT TARGET nfd)
+        add_library(nfd STATIC ${CMAKE_SOURCE_DIR}/src/android/nfd_android_stub.cpp)
+        target_include_directories(nfd PUBLIC ${RT64_DIR}/src/contrib/nativefiledialog-extended/src/include)
+    endif()
+endif()
+
 add_subdirectory(${RT64_DIR} ${CMAKE_BINARY_DIR}/rt64)
 
 set(BUILD_SHARED_LIBS OFF)
@@ -101,7 +111,12 @@ file(GLOB FUNC_CXX_SOURCES ${CMAKE_SOURCE_DIR}/RecompiledFuncs/*.cpp)
 target_sources(RecompiledFuncs PRIVATE ${FUNC_C_SOURCES} ${FUNC_CXX_SOURCES})
 
 # --- Main executable --------------------------------------------------------
-add_executable(BanjoTooieRecompiled)
+# On Android the game is a shared library that SDL's Java activity loads.
+if (ANDROID)
+    add_library(BanjoTooieRecompiled SHARED)
+else()
+    add_executable(BanjoTooieRecompiled)
+endif()
 
 set(SOURCES
     ${CMAKE_SOURCE_DIR}/src/main.cpp
@@ -225,6 +240,13 @@ if (APPLE)
     target_link_libraries(BanjoTooieRecompiled PRIVATE ${CMAKE_DL_LIBS} Threads::Threads SDL2::SDL2)
 endif()
 
+if (ANDROID)
+    add_compile_definitions("PLUME_SDL_VULKAN_ENABLED")
+    add_compile_definitions("RT64_SDL_WINDOW_VULKAN")
+    target_include_directories(BanjoTooieRecompiled PRIVATE ${SDL2_INCLUDE_DIRS} ${FREETYPE_INCLUDE_DIRS})
+    target_link_libraries(BanjoTooieRecompiled PRIVATE ${FREETYPE_LIBRARY} SDL2::SDL2 android log)
+endif()
+
 if (CMAKE_SYSTEM_NAME MATCHES "Linux")
     find_package(SDL2 REQUIRED)
     add_compile_definitions("PLUME_SDL_VULKAN_ENABLED")
@@ -277,7 +299,7 @@ else()
     # so the leading `VAR=value` element is load-bearing: CMake emits it
     # unquoted, and the shell reads it as an environment assignment for the
     # command that follows.
-    if (CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64")
+    if (CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "x86_64") # DXC runs on the build machine (cross builds target arm64)
         set(DXC "LD_LIBRARY_PATH=${RT64_DIR}/src/contrib/dxc/lib/x64" "${RT64_DIR}/src/contrib/dxc/bin/x64/dxc-linux")
     else()
         set(DXC "LD_LIBRARY_PATH=${RT64_DIR}/src/contrib/dxc/lib/arm64" "${RT64_DIR}/src/contrib/dxc/bin/arm64/dxc-linux")
diff --git a/src/android/nfd_android_stub.cpp b/src/android/nfd_android_stub.cpp
new file mode 100644
index 0000000..cc946a4
--- /dev/null
+++ b/src/android/nfd_android_stub.cpp
@@ -0,0 +1,147 @@
+// Android has no native file dialog backend; file dialogs report cancel. Via JFG Android port.
+// From Zelda64Recomp-Android (linkzenic).
+#include "nfd.h"
+
+#include <cstdlib>
+
+namespace {
+constexpr const char* kUnavailable = "Native file dialogs are unavailable on Android.";
+}
+
+extern "C" {
+
+NFD_API void NFD_FreePathN(nfdnchar_t* filePath) {
+    std::free(filePath);
+}
+
+NFD_API void NFD_FreePathU8(nfdu8char_t* filePath) {
+    std::free(filePath);
+}
+
+NFD_API nfdresult_t NFD_Init(void) {
+    return NFD_OKAY;
+}
+
+NFD_API void NFD_Quit(void) {
+}
+
+NFD_API nfdresult_t NFD_OpenDialogN(nfdnchar_t** outPath, const nfdnfilteritem_t*, nfdfiltersize_t, const nfdnchar_t*) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_OpenDialogU8(nfdu8char_t** outPath, const nfdu8filteritem_t*, nfdfiltersize_t, const nfdu8char_t*) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_OpenDialogMultipleN(const nfdpathset_t** outPaths, const nfdnfilteritem_t*, nfdfiltersize_t, const nfdnchar_t*) {
+    if (outPaths != nullptr) {
+        *outPaths = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_OpenDialogMultipleU8(const nfdpathset_t** outPaths, const nfdu8filteritem_t*, nfdfiltersize_t, const nfdu8char_t*) {
+    if (outPaths != nullptr) {
+        *outPaths = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_SaveDialogN(nfdnchar_t** outPath, const nfdnfilteritem_t*, nfdfiltersize_t, const nfdnchar_t*, const nfdnchar_t*) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_SaveDialogU8(nfdu8char_t** outPath, const nfdu8filteritem_t*, nfdfiltersize_t, const nfdu8char_t*, const nfdu8char_t*) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_PickFolderN(nfdnchar_t** outPath, const nfdnchar_t*) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_PickFolderU8(nfdu8char_t** outPath, const nfdu8char_t*) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API const char* NFD_GetError(void) {
+    return kUnavailable;
+}
+
+NFD_API void NFD_ClearError(void) {
+}
+
+NFD_API nfdresult_t NFD_PathSet_GetCount(const nfdpathset_t*, nfdpathsetsize_t* count) {
+    if (count != nullptr) {
+        *count = 0;
+    }
+    return NFD_OKAY;
+}
+
+NFD_API nfdresult_t NFD_PathSet_GetPathN(const nfdpathset_t*, nfdpathsetsize_t, nfdnchar_t** outPath) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_ERROR;
+}
+
+NFD_API nfdresult_t NFD_PathSet_GetPathU8(const nfdpathset_t*, nfdpathsetsize_t, nfdu8char_t** outPath) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_ERROR;
+}
+
+NFD_API void NFD_PathSet_FreePathN(const nfdnchar_t* filePath) {
+    std::free(const_cast<nfdnchar_t*>(filePath));
+}
+
+NFD_API void NFD_PathSet_FreePathU8(const nfdu8char_t* filePath) {
+    std::free(const_cast<nfdu8char_t*>(filePath));
+}
+
+NFD_API nfdresult_t NFD_PathSet_GetEnum(const nfdpathset_t*, nfdpathsetenum_t* outEnumerator) {
+    if (outEnumerator != nullptr) {
+        outEnumerator->ptr = nullptr;
+    }
+    return NFD_OKAY;
+}
+
+NFD_API void NFD_PathSet_FreeEnum(nfdpathsetenum_t*) {
+}
+
+NFD_API nfdresult_t NFD_PathSet_EnumNextN(nfdpathsetenum_t*, nfdnchar_t** outPath) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_OKAY;
+}
+
+NFD_API nfdresult_t NFD_PathSet_EnumNextU8(nfdpathsetenum_t*, nfdu8char_t** outPath) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_OKAY;
+}
+
+NFD_API void NFD_PathSet_Free(const nfdpathset_t*) {
+}
+
+}
diff --git a/src/main.cpp b/src/main.cpp
index 5068375..caa5335 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -536,6 +536,14 @@ void initialize_launcher_menu(recompui::LauncherMenu* menu) {
 
 }
 
+// Arguments for launchers and handhelds, on every platform:
+//   --rom <path>      select and validate a ROM without the launcher's file picker
+//   --skip-launcher   start the game directly once a valid ROM is stored
+//   --game-mode <id>  with --skip-launcher: start a custom game mode (an enabled mod's id) instead of the base game
+static const char* cli_rom_path = nullptr;
+static bool cli_skip_launcher = false;
+static const char* cli_game_mode = "";
+
 int main(int argc, char** argv) {
     std::fprintf(stderr, "[tooie] main entered\n");
     std::fflush(stderr);
@@ -554,8 +562,15 @@ int main(int argc, char** argv) {
         std::abort();
     });
 
-    (void)argc;
-    (void)argv;
+    for (int i = 1; i < argc; i++) {
+        if (std::strcmp(argv[i], "--rom") == 0 && i + 1 < argc) {
+            cli_rom_path = argv[++i];
+        } else if (std::strcmp(argv[i], "--skip-launcher") == 0) {
+            cli_skip_launcher = true;
+        } else if (std::strcmp(argv[i], "--game-mode") == 0 && i + 1 < argc) {
+            cli_game_mode = argv[++i];
+        }
+    }
 
     SDL_SetMainReady();
     std::fprintf(stderr, "[tooie] step sdl_setmainready\n"); std::fflush(stderr);
@@ -718,6 +733,17 @@ int main(int argc, char** argv) {
     configuration.error_handling_callbacks = error_handling_callbacks;
     configuration.threads_callbacks = threads_callbacks;
 
+    if (cli_rom_path != nullptr) {
+        recomp::RomValidationError rom_error = recomp::select_rom(cli_rom_path, supported_games.front().game_id);
+        std::fprintf(stderr, "--rom %s: %s\n", cli_rom_path,
+            rom_error == recomp::RomValidationError::Good ? "accepted" : "rejected (wrong or modified ROM)");
+    }
+    if (cli_skip_launcher && recomp::is_rom_valid(supported_games.front().game_id)) {
+        // As the launcher's start option does (needs the runtime's "set_dummy_vi at least once" fix).
+        recomp::start_game(supported_games.front().game_id, cli_game_mode); // empty: the base game
+        recompui::hide_all_contexts();
+    }
+
     std::fprintf(stderr, "[tooie] step before start\n"); std::fflush(stderr);
     recomp::start(configuration);
     std::fprintf(stderr, "[tooie] step after start\n"); std::fflush(stderr);
-- 
