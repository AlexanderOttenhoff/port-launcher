diff --git a/src/render/rt64_descriptor_sets.h b/src/render/rt64_descriptor_sets.h
index 69a82ac..57cfe68 100644
--- a/src/render/rt64_descriptor_sets.h
+++ b/src/render/rt64_descriptor_sets.h
@@ -291,18 +291,30 @@ namespace RT64 {
     };
 
     struct FramebufferRendererDescriptorTextureSet : RenderDescriptorSetBase {
+#if defined(__ANDROID__)
+        static const int UpperRange = 1024;
+#else
         static const int UpperRange = 8192;
+#endif
 
         uint32_t textureCacheSize = 0;
         uint32_t gTextures;
         uint32_t gTMEM;
 
         FramebufferRendererDescriptorTextureSet(RenderDevice *device = nullptr, uint32_t textureCacheSize = 0) {
+#if defined(__ANDROID__)
+            // The variable count can't exceed the declared range (and the shaders' RT64_TEXTURE_CACHE_SIZE).
+            if (textureCacheSize > UpperRange) {
+                fprintf(stderr, "Texture cache wants %u descriptors; Android build is limited to %d.\n", textureCacheSize, UpperRange);
+                textureCacheSize = UpperRange;
+            }
+#endif
             this->textureCacheSize = textureCacheSize;
 
             builder.begin();
             gTextures = builder.addTexture(0, UpperRange);
             gTMEM = gTextures;
+            // Boundless: update-after-bind and partially bound, which the texture cache relies on.
             builder.end(true, textureCacheSize);
 
             if (device != nullptr) {
diff --git a/src/render/rt64_shader_library.cpp b/src/render/rt64_shader_library.cpp
index d1c5273..b79c3d1 100644
--- a/src/render/rt64_shader_library.cpp
+++ b/src/render/rt64_shader_library.cpp
@@ -599,7 +599,12 @@ namespace RT64 {
             RenderGraphicsPipelineDesc pipelineDesc;
             pipelineDesc.vertexShader = fullScreenVertexShader.get();
             pipelineDesc.pixelShader = regularShader.get();
+#ifdef __ANDROID__
+            // Must match the Android swap chain format in Application.
+            pipelineDesc.renderTargetFormat[0] = RenderFormat::R8G8B8A8_UNORM;
+#else
             pipelineDesc.renderTargetFormat[0] = RenderFormat::B8G8R8A8_UNORM; // TODO: Use whatever format the swap chain was created with.
+#endif
             pipelineDesc.renderTargetBlend[0] = RenderBlendDesc::Copy();
             pipelineDesc.renderTargetCount = 1;
             pipelineDesc.pipelineLayout = videoInterfaceNearest.pipelineLayout.get();
