diff --git a/CMakeLists.txt b/CMakeLists.txt
index 29bc96e..a32b587 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -109,6 +109,9 @@ set(ANDROID_ABI arm64-v8a)
 
 # For DXC
 set (DXC_COMMON_OPTS "-I${PROJECT_SOURCE_DIR}/src")
+if (ANDROID)
+    list(APPEND DXC_COMMON_OPTS "-D" "RT64_TEXTURE_CACHE_SIZE=1024")
+endif()
 set (DXC_DXIL_OPTS "-Wno-ignored-attributes")
 set (DXC_SPV_OPTS "-spirv" "-fspv-target-env=vulkan1.0" "-fvk-use-dx-layout")
 set (DXC_LB_OPTS "${DXC_COMMON_OPTS}" "-D" "LIBRARY" "-T" "lib_6_3")
diff --git a/src/hle/rt64_application.cpp b/src/hle/rt64_application.cpp
index 162b00a..481e9d4 100644
--- a/src/hle/rt64_application.cpp
+++ b/src/hle/rt64_application.cpp
@@ -325,7 +325,12 @@ namespace RT64 {
         // Create the swap chain with the texture count specified from the configuration.
         RenderSwapChainDesc swapChainDesc;
         swapChainDesc.renderWindow = appWindow->windowHandle;
+#ifdef __ANDROID__
+        // Android guarantees RGBA8 surfaces, not desktop BGRA8. The VI pipeline in the shader library must match.
+        swapChainDesc.format = RenderFormat::R8G8B8A8_UNORM;
+#else
         swapChainDesc.format = RenderFormat::B8G8R8A8_UNORM;
+#endif
         swapChainDesc.textureCount = (userConfig.displayBuffering == UserConfiguration::DisplayBuffering::Triple) ? 3 : 2;
 
         if (device->getCapabilities().presentWait) {
