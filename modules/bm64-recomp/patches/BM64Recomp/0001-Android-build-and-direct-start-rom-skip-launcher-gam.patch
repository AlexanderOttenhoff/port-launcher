+# Android: find SDL2 before the subprojects, so they see SDL2_INCLUDE_DIRS, and give RT64 a stub nfd target (Android
+# has no native file dialogs; the ROM comes from the port launcher via --rom).
+if (ANDROID)
+    find_package(SDL2 REQUIRED)
+    if (NOT TARGET nfd)
+        add_library(nfd STATIC ${CMAKE_SOURCE_DIR}/src/android/nfd_android_stub.cpp)
+        target_include_directories(nfd PUBLIC ${CMAKE_SOURCE_DIR}/lib/rt64/src/contrib/nativefiledialog-extended/src/include)
+    endif()
