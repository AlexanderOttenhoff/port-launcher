@@ -528,9 +529,23 @@ void reorder_texture_pack(recomp::mods::ModContext&) {
 
 #define REGISTER_FUNC(name) recomp::overlays::register_base_export(#name, name)
 
+// Arguments for launchers and handhelds, on every platform:
+//   --rom <path>      select and validate a ROM without the launcher's file picker
+//   --skip-launcher   start the game directly once a valid ROM is stored
+//   --game-mode <id>  accepted for launcher compatibility and ignored: this runtime has no custom game modes
+static const char* cli_rom_path = nullptr;
+static bool cli_skip_launcher = false;
+
 int main(int argc, char** argv) {
-    (void)argc;
-    (void)argv;
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "--rom") == 0 && i + 1 < argc) {
+            cli_rom_path = argv[++i];
+        } else if (strcmp(argv[i], "--skip-launcher") == 0) {
+            cli_skip_launcher = true;
+        } else if (strcmp(argv[i], "--game-mode") == 0 && i + 1 < argc) {
+            ++i;
+        }
+    }
     recomp::Version project_version{};
     if (!recomp::Version::from_string(version_string, project_version)) {
         ultramodern::error_handling::message_box(("Invalid version string: " + version_string).c_str());
@@ -684,6 +699,18 @@ int main(int argc, char** argv) {
     // Register the .rtz texture pack file format with the previous content type as its only allowed content type.
     recomp::mods::register_mod_container_type("rtz", std::vector{ texture_pack_content_type_id }, false);
 
+    if (cli_rom_path != nullptr) {
+        recomp::RomValidationError rom_error = recomp::select_rom(cli_rom_path, supported_games[0].game_id);
+        fprintf(stderr, "--rom %s: %s\n", cli_rom_path,
+            rom_error == recomp::RomValidationError::Good ? "accepted" : "rejected (wrong or modified ROM)");
+    }
+    if (cli_skip_launcher && recomp::is_rom_valid(supported_games[0].game_id)) {
+        // As the launcher's "start_game" event does (ui_launcher.cpp). Calling it before recomp::start relies on the
+        // runtime's "always call set_dummy_vi at least once" fix (modules/banjo-recomp/patches/N64ModernRuntime).
+        recomp::start_game(supported_games[0].game_id);
+        recompui::hide_all_contexts();
+    }
+
     recomp::Configuration cfg{
         .project_version = project_version,
         .window_handle = {},
