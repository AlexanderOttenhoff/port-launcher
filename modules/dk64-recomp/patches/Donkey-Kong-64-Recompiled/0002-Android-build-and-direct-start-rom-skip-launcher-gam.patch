From dfce8402e7f359a3220813ead981b53f172b6468 Mon Sep 17 00:00:00 2001
From: Alexander Ottenhoff <AlexanderOttenhoff@users.noreply.github.com>
Date: Wed, 11 Nov 2026 19:56:51 +1100
Subject: [PATCH 2/2] Android build and direct start (--rom, --skip-launcher,
 --game-mode)

---
 CMakeLists.txt                   |  33 ++++++-
 src/android/nfd_android_stub.cpp | 147 +++++++++++++++++++++++++++++++
 src/main/main.cpp                |  32 ++++++-
 3 files changed, 205 insertions(+), 7 deletions(-)
 create mode 100644 src/android/nfd_android_stub.cpp

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7ec338f..5dbc5ce 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,10 +1,13 @@
 cmake_minimum_required(VERSION 3.20)
 
+# Android builds use the NDK toolchain and the app's own static SDL2; vcpkg's toolchain would replace them.
+if (NOT ANDROID)
 if(NOT DEFINED ENV{VCPKG_ROOT})
     set(ENV{VCPKG_ROOT} ${CMAKE_SOURCE_DIR}/lib/vcpkg)
 endif()
 
 include($ENV{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake)
+endif()
 
 if (APPLE)
     set(CMAKE_OSX_DEPLOYMENT_TARGET "11.0" CACHE STRING "Minimum OS X deployment version")
@@ -59,6 +62,16 @@ if (RECOMP_FLATPAK)
     add_compile_definitions(RECOMP_FLATPAK)
 endif()
 
+# Android: find SDL2 before the subprojects, so they see SDL2_INCLUDE_DIRS, and give RT64/RecompFrontend a stub nfd
+# target (no native file dialogs; the ROM comes from the launcher).
+if (ANDROID)
+    find_package(SDL2 REQUIRED)
+    if (NOT TARGET nfd)
+        add_library(nfd STATIC ${CMAKE_SOURCE_DIR}/src/android/nfd_android_stub.cpp)
+        target_include_directories(nfd PUBLIC ${CMAKE_SOURCE_DIR}/lib/rt64/src/contrib/nativefiledialog-extended/src/include)
+    endif()
+endif()
+
 add_subdirectory(${CMAKE_SOURCE_DIR}/lib/rt64 ${CMAKE_BINARY_DIR}/rt64)
 
 set(BUILD_SHARED_LIBS OFF)
@@ -132,7 +145,7 @@ add_custom_target(PatchesBin
 
 # Generate patches_bin.c from patches.bin
 add_custom_command(OUTPUT ${CMAKE_SOURCE_DIR}/RecompiledPatches/patches_bin.c
-    COMMAND file_to_c ${CMAKE_SOURCE_DIR}/patches/patches.bin bk_patches_bin ${CMAKE_SOURCE_DIR}/RecompiledPatches/patches_bin.c ${CMAKE_SOURCE_DIR}/RecompiledPatches/patches_bin.h
+    COMMAND ${RT64_HOST_FILE_TO_C} ${CMAKE_SOURCE_DIR}/patches/patches.bin bk_patches_bin ${CMAKE_SOURCE_DIR}/RecompiledPatches/patches_bin.c ${CMAKE_SOURCE_DIR}/RecompiledPatches/patches_bin.h
     DEPENDS ${CMAKE_SOURCE_DIR}/patches/patches.bin
 )
 
@@ -149,7 +162,12 @@ add_custom_command(OUTPUT
 )
 
 # Main executable
-add_executable(DK64Recompiled)
+# On Android the game is a shared library that SDL's Java activity loads.
+if (ANDROID)
+    add_library(DK64Recompiled SHARED)
+else()
+    add_executable(DK64Recompiled)
+endif()
 
 set (SOURCES
     ${CMAKE_SOURCE_DIR}/src/main/launcher_animation.cpp
@@ -188,7 +206,7 @@ target_include_directories(DK64Recompiled PRIVATE
 
 # Generate icon_bytes.c from the app icon PNG.
 add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/icon_bytes.c ${CMAKE_CURRENT_BINARY_DIR}/icon_bytes.h
-    COMMAND file_to_c ${CMAKE_SOURCE_DIR}/icons/app.png icon_bytes ${CMAKE_CURRENT_BINARY_DIR}/icon_bytes.c ${CMAKE_CURRENT_BINARY_DIR}/icon_bytes.h
+    COMMAND ${RT64_HOST_FILE_TO_C} ${CMAKE_SOURCE_DIR}/icons/app.png icon_bytes ${CMAKE_CURRENT_BINARY_DIR}/icon_bytes.c ${CMAKE_CURRENT_BINARY_DIR}/icon_bytes.h
     DEPENDS ${CMAKE_SOURCE_DIR}/icons/app.png
 )
 
@@ -274,6 +292,13 @@ if (APPLE)
     include(${CMAKE_SOURCE_DIR}/.github/macos/apple_bundle.cmake)
 endif()
 
+if (ANDROID)
+    add_compile_definitions("PLUME_SDL_VULKAN_ENABLED")
+    add_compile_definitions("RT64_SDL_WINDOW_VULKAN")
+    target_include_directories(DK64Recompiled PRIVATE ${SDL2_INCLUDE_DIRS} ${FREETYPE_INCLUDE_DIRS})
+    target_link_libraries(DK64Recompiled PRIVATE ${FREETYPE_LIBRARY} SDL2::SDL2 android log)
+endif()
+
 if (CMAKE_SYSTEM_NAME MATCHES "Linux")
     find_package(SDL2 REQUIRED)
     find_package(X11 REQUIRED)
@@ -371,7 +396,7 @@ foreach(NRM_FILE ${NRM_FILES})
 
     add_custom_command(
         OUTPUT ${OUT_C} ${OUT_H}
-        COMMAND file_to_c ${NRM_FILE} ${NRM_NAME} ${OUT_C} ${OUT_H}
+        COMMAND ${RT64_HOST_FILE_TO_C} ${NRM_FILE} ${NRM_NAME} ${OUT_C} ${OUT_H}
         DEPENDS ${NRM_FILE}
     )
 
diff --git a/src/android/nfd_android_stub.cpp b/src/android/nfd_android_stub.cpp
new file mode 100644
index 0000000..cc946a4
--- /dev/null
+++ b/src/android/nfd_android_stub.cpp
@@ -0,0 +1,147 @@
+// Android has no native file dialog backend; file dialogs report cancel. Via JFG Android port.
+// From Zelda64Recomp-Android (linkzenic).
+#include "nfd.h"
+
+#include <cstdlib>
+
+namespace {
+constexpr const char* kUnavailable = "Native file dialogs are unavailable on Android.";
+}
+
+extern "C" {
+
+NFD_API void NFD_FreePathN(nfdnchar_t* filePath) {
+    std::free(filePath);
+}
+
+NFD_API void NFD_FreePathU8(nfdu8char_t* filePath) {
+    std::free(filePath);
+}
+
+NFD_API nfdresult_t NFD_Init(void) {
+    return NFD_OKAY;
+}
+
+NFD_API void NFD_Quit(void) {
+}
+
+NFD_API nfdresult_t NFD_OpenDialogN(nfdnchar_t** outPath, const nfdnfilteritem_t*, nfdfiltersize_t, const nfdnchar_t*) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_OpenDialogU8(nfdu8char_t** outPath, const nfdu8filteritem_t*, nfdfiltersize_t, const nfdu8char_t*) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_OpenDialogMultipleN(const nfdpathset_t** outPaths, const nfdnfilteritem_t*, nfdfiltersize_t, const nfdnchar_t*) {
+    if (outPaths != nullptr) {
+        *outPaths = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_OpenDialogMultipleU8(const nfdpathset_t** outPaths, const nfdu8filteritem_t*, nfdfiltersize_t, const nfdu8char_t*) {
+    if (outPaths != nullptr) {
+        *outPaths = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_SaveDialogN(nfdnchar_t** outPath, const nfdnfilteritem_t*, nfdfiltersize_t, const nfdnchar_t*, const nfdnchar_t*) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_SaveDialogU8(nfdu8char_t** outPath, const nfdu8filteritem_t*, nfdfiltersize_t, const nfdu8char_t*, const nfdu8char_t*) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_PickFolderN(nfdnchar_t** outPath, const nfdnchar_t*) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API nfdresult_t NFD_PickFolderU8(nfdu8char_t** outPath, const nfdu8char_t*) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_CANCEL;
+}
+
+NFD_API const char* NFD_GetError(void) {
+    return kUnavailable;
+}
+
+NFD_API void NFD_ClearError(void) {
+}
+
+NFD_API nfdresult_t NFD_PathSet_GetCount(const nfdpathset_t*, nfdpathsetsize_t* count) {
+    if (count != nullptr) {
+        *count = 0;
+    }
+    return NFD_OKAY;
+}
+
+NFD_API nfdresult_t NFD_PathSet_GetPathN(const nfdpathset_t*, nfdpathsetsize_t, nfdnchar_t** outPath) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_ERROR;
+}
+
+NFD_API nfdresult_t NFD_PathSet_GetPathU8(const nfdpathset_t*, nfdpathsetsize_t, nfdu8char_t** outPath) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_ERROR;
+}
+
+NFD_API void NFD_PathSet_FreePathN(const nfdnchar_t* filePath) {
+    std::free(const_cast<nfdnchar_t*>(filePath));
+}
+
+NFD_API void NFD_PathSet_FreePathU8(const nfdu8char_t* filePath) {
+    std::free(const_cast<nfdu8char_t*>(filePath));
+}
+
+NFD_API nfdresult_t NFD_PathSet_GetEnum(const nfdpathset_t*, nfdpathsetenum_t* outEnumerator) {
+    if (outEnumerator != nullptr) {
+        outEnumerator->ptr = nullptr;
+    }
+    return NFD_OKAY;
+}
+
+NFD_API void NFD_PathSet_FreeEnum(nfdpathsetenum_t*) {
+}
+
+NFD_API nfdresult_t NFD_PathSet_EnumNextN(nfdpathsetenum_t*, nfdnchar_t** outPath) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_OKAY;
+}
+
+NFD_API nfdresult_t NFD_PathSet_EnumNextU8(nfdpathsetenum_t*, nfdu8char_t** outPath) {
+    if (outPath != nullptr) {
+        *outPath = nullptr;
+    }
+    return NFD_OKAY;
+}
+
+NFD_API void NFD_PathSet_Free(const nfdpathset_t*) {
+}
+
+}
diff --git a/src/main/main.cpp b/src/main/main.cpp
index ae0dc74..484c68e 100644
--- a/src/main/main.cpp
+++ b/src/main/main.cpp
@@ -241,7 +241,7 @@ ultramodern::renderer::WindowHandle create_window(ultramodern::gfx_callbacks_t::
     bool choose_kazooie_icon = (rand() % 2 == 0);
     HICON new_icon = LoadIcon(GetModuleHandle(NULL), choose_kazooie_icon ? MAKEINTRESOURCE(APP_ICON_K) : MAKEINTRESOURCE(APP_ICON_B));
     SendMessage(wmInfo.info.win.window, WM_SETICON, ICON_SMALL2, (LPARAM)(new_icon));
-#elif defined(__linux__)
+#elif defined(__gnu_linux__) // as SetImageAsIcon itself; Android defines __linux__ but has no window icons
     SetImageAsIcon("icons/app.png", window);
 #endif
 
@@ -679,9 +679,24 @@ void on_launcher_init(recompui::LauncherMenu *menu) {
 
 #define REGISTER_FUNC(name) recomp::overlays::register_base_export(#name, name)
 
+// Arguments for launchers and handhelds, on every platform:
+//   --rom <path>      select and validate a ROM without the launcher's file picker
+//   --skip-launcher   start the game directly once a valid ROM is stored
+//   --game-mode <id>  with --skip-launcher: start a custom game mode (an enabled mod's id) instead of the base game
+static const char* cli_rom_path = nullptr;
+static bool cli_skip_launcher = false;
+static const char* cli_game_mode = "";
+
 int main(int argc, char** argv) {
-    (void)argc;
-    (void)argv;
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "--rom") == 0 && i + 1 < argc) {
+            cli_rom_path = argv[++i];
+        } else if (strcmp(argv[i], "--skip-launcher") == 0) {
+            cli_skip_launcher = true;
+        } else if (strcmp(argv[i], "--game-mode") == 0 && i + 1 < argc) {
+            cli_game_mode = argv[++i];
+        }
+    }
     recomp::Version project_version{};
     if (!recomp::Version::from_string(version_string, project_version)) {
         ultramodern::error_handling::message_box(("Invalid version string: " + version_string).c_str());
@@ -873,6 +888,17 @@ int main(int argc, char** argv) {
     // Register the .rtz texture pack file format with the previous content type as its only allowed content type.
     recomp::mods::register_mod_container_type("rtz", std::vector{ texture_pack_content_type_id }, false);
 
+    if (cli_rom_path != nullptr) {
+        recomp::RomValidationError rom_error = recomp::select_rom(cli_rom_path, supported_games[0].game_id);
+        fprintf(stderr, "--rom %s: %s\n", cli_rom_path,
+            rom_error == recomp::RomValidationError::Good ? "accepted" : "rejected (wrong or modified ROM)");
+    }
+    if (cli_skip_launcher && recomp::is_rom_valid(supported_games[0].game_id)) {
+        // As the launcher's start option does (needs the runtime's "set_dummy_vi at least once" fix).
+        recomp::start_game(supported_games[0].game_id, cli_game_mode); // empty: the base game
+        recompui::hide_all_contexts();
+    }
+
     recomp::Configuration cfg {
         .argc = argc,
         .argv = argv,
