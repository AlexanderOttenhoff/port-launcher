diff --git a/scripts/strip_weak_pragmas.py b/scripts/strip_weak_pragmas.py
index 335a1631..2ab7fc0a 100644
--- a/scripts/strip_weak_pragmas.py
+++ b/scripts/strip_weak_pragmas.py
@@ -7,15 +7,33 @@ import sys
 
 
 def main() -> int:
-    if len(sys.argv) != 3:
-        print(f"usage: {sys.argv[0]} INPUT OUTPUT", file=sys.stderr)
+    argv = sys.argv[1:]
+    # --alias (ELF/Clang, Android): re-create each `#pragma weak A = B` as a
+    # hidden weak alias attribute at the end of the file, where B is defined.
+    alias = bool(argv) and argv[0] == "--alias"
+    if alias:
+        argv = argv[1:]
+    if len(argv) != 2:
+        print(f"usage: {sys.argv[0]} [--alias] INPUT OUTPUT", file=sys.stderr)
         return 2
 
-    source = pathlib.Path(sys.argv[1])
-    output = pathlib.Path(sys.argv[2])
+    source = pathlib.Path(argv[0])
+    output = pathlib.Path(argv[1])
     text = source.read_text(encoding="utf-8")
+    pairs = re.findall(r"^[ \t]*#pragma[ \t]+weak[ \t]+(\w+)[ \t]*=[ \t]*(\w+)",
+                       text, flags=re.MULTILINE)
     text = re.sub(r"^[ \t]*#pragma[ \t]+weak[^\n]*\n", "", text,
                   flags=re.MULTILINE)
+    if alias and pairs:
+        text += "\n/* #pragma weak aliases (strip_weak_pragmas.py --alias) */\n"
+        for name, target in pairs:
+            # The file may #define the alias name (sinf.c: fsin -> __sinf), and
+            # may already declare it with its own type (spectrum.c: u8 vs u8[]).
+            declared = re.search(r"extern[^;(]*\b%s\s*;" % re.escape(name), text)
+            kind = name if declared else target
+            text += (f"#undef {name}\n"
+                     f"extern __typeof__({kind}) {name} "
+                     f"__attribute__((weak, alias(\"{target}\"), visibility(\"hidden\")));\n")
     output.parent.mkdir(parents=True, exist_ok=True)
     output.write_text(text, encoding="utf-8")
     return 0
