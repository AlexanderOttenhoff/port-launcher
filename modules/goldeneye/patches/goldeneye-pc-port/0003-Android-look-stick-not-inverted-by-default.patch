From 588ff628feeb029b742e89cdd46ad5cc6dd4479d Mon Sep 17 00:00:00 2001
From: Alexander Ottenhoff <AlexanderOttenhoff@users.noreply.github.com>
Date: Thu, 12 Nov 2026 14:07:41 +1100
Subject: [PATCH] Android: look stick not inverted by default

---
 port/src/input.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/port/src/input.c b/port/src/input.c
index 7cb95cf4..a51bb379 100644
--- a/port/src/input.c
+++ b/port/src/input.c
@@ -523,6 +523,14 @@ static int controlScheme = 0;                    /* D513 Input.ControlScheme: 0
 int inputControlScheme(void) { return controlScheme; }
 /* D645: Original scheme -- F10 "Invert look" mirrors the game's own
  * "Look up/down" (watchsettings.c keeps the two in sync both ways). */
+/* Port launcher: on Android the look stick came out inverted with "Invert look"
+ * off (seen on a Retroid Pocket 6), so the row's meaning is reversed there:
+ * off = push up to look up, the launcher's default for every game. */
+#ifdef __ANDROID__
+#define PLM_LOOK_INVERTED(v) (!(v))
+#else
+#define PLM_LOOK_INVERTED(v) (v)
+#endif
 static int padLookInvertY = 0;                   /* Input.PadLookInvertY: 1 = invert the look stick's Y (right stick in SOLITARE roles, left stick in HONEY roles -- #145) */
 int inputPadLookInvert(void) { return padLookInvertY; }
 void inputSetPadLookInvert(int v) { padLookInvertY = v ? 1 : 0; }
@@ -3020,7 +3028,7 @@ static unsigned inputComputePadSlot(int idx, signed char *stick_x, signed char *
                 rxs = (int)lround(padSmSX[idx]);
                 rys = (int)lround(padSmSY[idx]);
             }
-            if (padLookInvertY) rys = -rys;
+            if (PLM_LOOK_INVERTED(padLookInvertY)) rys = -rys;
             if (idx == 0) { s_recPadDX = rxs; s_recPadDY = rys; s_recPadDirect = 0; }
             if (aimModeGet() == AIMMODE_CENTRED && !(idx == 0 && s_replayActive) &&
                 padDirectCompute(rxs, rys)) {
@@ -3053,7 +3061,7 @@ static unsigned inputComputePadSlot(int idx, signed char *stick_x, signed char *
              * (look) right-stick channel. */
             /* D645: not in Original -- there the game's own "Look up/down"
              * (mirrored from this row by watchsettings.c) inverts natively. */
-            if (padLookInvertY && !controlScheme) py = -py;
+            if (PLM_LOOK_INVERTED(padLookInvertY) && !controlScheme) py = -py;
             if (px) sx = px;
             if (py) sy = py;
             if (idx == 0 && (px || py)) s_aimDevMouse = 0;   /* D337: pad aim active */
-- 
2.43.0

