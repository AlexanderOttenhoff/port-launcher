+#endif
 void lvlManageMpGame(void)
 {
     tlbmanageResetCurrentEntriesCount();
@@ -1077,6 +1080,14 @@ void lvlManageMpGame(void)
     {
         g_ClockTimer = 0;
     }
+#ifdef __ANDROID__
+    /* [port launcher] the quick weapon select list (plm_weaponlist.c) holds the world still while it's open, the same
+     * way the multiplayer pause does: a zero clock this frame */
