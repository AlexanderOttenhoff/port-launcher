From 43932aaef7f85486d1bf355da864e0eeb6d3dc91 Mon Sep 17 00:00:00 2001
From: plm <plm@localhost>
Date: Sun, 15 Nov 2026 17:54:12 +1100
Subject: [PATCH] Android: quick weapon select (hold next weapon for the
 inventory list, release to equip; the game pauses while it's open)

---
 port/src/input.c          |  51 +++++++++++
 src/game/bondview2.c      |   7 ++
 src/game/lv.c             |  11 +++
 src/game/plm_weaponlist.c | 182 ++++++++++++++++++++++++++++++++++++++
 4 files changed, 251 insertions(+)
 create mode 100644 src/game/plm_weaponlist.c

diff --git a/port/src/input.c b/port/src/input.c
index 3d237940..b3d3e1f4 100644
--- a/port/src/input.c
+++ b/port/src/input.c
@@ -3109,6 +3109,57 @@ static unsigned inputComputePadSlot(int idx, signed char *stick_x, signed char *
             const PadBinds *pb = &padTabGet()->seat[padSeatForSlot(idx)];
             padMapPure(pb, padReadRaw(pad), padActPrev[idx], button, &pc, &po);
             button = po.button;
+#ifdef __ANDROID__
+            /* [port launcher] Quick weapon select (src/game/plm_weaponlist.c; owner 2026-11-15). Player one, on foot
+             * in single player, modern scheme only. Next weapon no longer cycles on press: a tap (released within
+             * 250 ms) sends the same A press on release, so tapping cycles as before; holding opens the list, the
+             * stick or D-pad moves the highlight (and doesn't reach the game meanwhile), releasing equips. */
+            if (idx == 0 && pc.facePlayable && !pc.orig && getPlayerCount() == 1) {
+                extern s32 plmWeaponListIsOpen(void);
+                extern void plmWeaponListOpen(void), plmWeaponListMove(s32 dir), plmWeaponListCommit(void);
+                extern u32 g_plmWlDown;
+#define s_wlDown g_plmWlDown
+                static u32 s_wlRepeat;      /* next tick a held stick/D-pad may move the highlight again */
+                static int s_wlStickPrev;   /* -1 / 0 / +1: last navigation direction */
+                const u32 now = SDL_GetTicks();
+                const int held = (po.actHeld & (1u << PA_NEXTWPN)) != 0;
+                if (held) {
+                    button &= ~GE_CONT_A;   /* no cycle on press; decided on release or by the hold */
+                    if (!s_wlDown) s_wlDown = now ? now : 1;
+                    if (!plmWeaponListIsOpen() && now - s_wlDown >= 250) {
+                        plmWeaponListOpen();
+                        s_wlStickPrev = 0;
+                    }
+                    if (plmWeaponListIsOpen()) {
+                        int dir = 0;
+                        /* D-pad, or the left stick: in the modern (SOLITARE) role it arrives as C-buttons, up =
+                         * C-up (E), down = C-down (D) (see the stick block above); sy covers the other roles. */
+                        if ((button & (GE_CONT_UP | GE_CONT_E)) || sy > 40) dir = -1;
+                        if ((button & (GE_CONT_DOWN | GE_CONT_D)) || sy < -40) dir = 1;
+                        if (dir && (dir != s_wlStickPrev || now >= s_wlRepeat)) {
+                            plmWeaponListMove(dir);
+                            s_wlRepeat = now + (dir != s_wlStickPrev ? 350 : 120);
+                        }
+                        s_wlStickPrev = dir;
+                        sx = sy = 0;   /* the list owns the stick and D-pad while open */
+                        button &= ~(GE_CONT_UP | GE_CONT_DOWN | GE_CONT_LEFT | GE_CONT_RIGHT |
+                                    GE_CONT_C | GE_CONT_D | GE_CONT_E | GE_CONT_F);
+                    }
+                } else if (s_wlDown) {
+                    if (plmWeaponListIsOpen()) plmWeaponListCommit();
+                    else button |= GE_CONT_A;   /* a tap: cycle as before */
+                    s_wlDown = 0;
+                }
+#undef s_wlDown
+            } else if (idx == 0) {
+                extern u32 g_plmWlDown;
+                g_plmWlDown = 0;
+                /* Left gameplay (menu, pause, cutscene, tank) mid-hold: forget the hold and close the list, so the
+                 * next press starts fresh instead of opening at once. */
+                extern void plmWeaponListClose(void);
+                plmWeaponListClose();
+            }
+#endif
             if (po.crouch) crouchNow = 1;
             if (po.gadgetEdge) inputCycleGadget();
             padActPrev[idx] = po.actHeld;
diff --git a/src/game/bondview2.c b/src/game/bondview2.c
index c0a4e2f4..79ee49b3 100644
--- a/src/game/bondview2.c
+++ b/src/game/bondview2.c
@@ -9532,6 +9532,13 @@ Gfx *maybe_mp_interface(Gfx *gdl)
     PORT_HUD_ASPECT(gdl, GE_HUD_ASPECT_CENTER);
 #endif
     gdl = countdownTimerRender(gdl);
+#ifdef __ANDROID__
+    {
+        /* [port launcher] quick weapon select (plm_weaponlist.c), in the same centred HUD space as the timer */
+        extern Gfx *plmWeaponListRender(Gfx *gdl);
+        gdl = plmWeaponListRender(gdl);
+    }
+#endif
 #ifdef PORT
     PORT_HUD_ASPECT(gdl, GE_HUD_ASPECT_NONE);
 #endif
diff --git a/src/game/lv.c b/src/game/lv.c
index 31a62db0..75017dc1 100644
--- a/src/game/lv.c
+++ b/src/game/lv.c
@@ -1065,6 +1065,9 @@ void lvlSetMultipliersForDifficulty(void)
  * Address: 0x7F0BF7AC (NTSC-J).
  * Address: 0x7F0BDFAC (PAL).
  */
