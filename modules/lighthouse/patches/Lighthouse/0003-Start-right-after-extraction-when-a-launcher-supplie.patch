From 65814ab39e8110141248d8cd24da8a80fedbcd7d Mon Sep 17 00:00:00 2001
From: Alexander Ottenhoff <AlexanderOttenhoff@users.noreply.github.com>
Date: Thu, 12 Nov 2026 09:13:05 +1100
Subject: [PATCH] Start right after extraction when a launcher supplies the ROM
 (PLM_ROM)

---
 libultraship                       | 2 +-
 src/port/Extractor/ExtractFlow.cpp | 6 +++++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/libultraship b/libultraship
index 92ed57bc..eb12a4a8 160000
--- a/libultraship
+++ b/libultraship
@@ -1 +1 @@
-Subproject commit 92ed57bc54ad44c6a23425cd6ba58b56cced228e
+Subproject commit eb12a4a8ffab348f98a10e212e7b97ad56bb84ea
diff --git a/src/port/Extractor/ExtractFlow.cpp b/src/port/Extractor/ExtractFlow.cpp
index 58f46790..b41ead27 100644
--- a/src/port/Extractor/ExtractFlow.cpp
+++ b/src/port/Extractor/ExtractFlow.cpp
@@ -406,7 +406,11 @@ void GameEngine::RunExtract(int argc, char* argv[]) {
             case ES_EXTRACT_ARGS: {
                 romArchive = nullptr;
 #if !defined(__SWITCH__) && !defined(__WIIU__)
-                if (args.size() == 0) {
+                if (args.size() == 0 && std::getenv("PLM_ROM") != nullptr && AnyRomArchiveExists()) {
+                    // [plm] A launcher supplied the ROM: start straight after extraction, no prompt.
+                    extractStep = ES_VERIFY;
+                    break;
+                } else if (args.size() == 0) {
                     LighthouseGui::RegisterPopup(
                         "Run Lighthouse", "All files have been processed. Run Lighthouse?", "Yes", "No",
                         [&]() {
-- 
