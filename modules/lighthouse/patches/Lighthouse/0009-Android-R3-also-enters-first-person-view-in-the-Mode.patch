From 785f0f698f1696e591acadfea533e29e65389581 Mon Sep 17 00:00:00 2001
From: Alexander Ottenhoff <AlexanderOttenhoff@users.noreply.github.com>
Date: Thu, 12 Nov 2026 14:53:24 +1100
Subject: [PATCH] Android: R3 also enters first-person view in the Modern
 scheme

---
 src/port/Controller/ControlSchemes.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/port/Controller/ControlSchemes.cpp b/src/port/Controller/ControlSchemes.cpp
index 16e7b1d8..fe44637f 100644
--- a/src/port/Controller/ControlSchemes.cpp
+++ b/src/port/Controller/ControlSchemes.cpp
@@ -167,7 +167,9 @@ void ControlSchemes_Apply(int scheme) {
             ClearButtonSDL(controller, BTN_CUP);
             BindButton(controller, BTN_CUP, SDL_CONTROLLER_BUTTON_Y);
 #ifdef __ANDROID__
-            // [port launcher] B stays B (attack) by label; C-down (zoom / eggs) takes X instead.
+            // [port launcher] B stays B (attack) by label; C-down (zoom / eggs) takes X instead. R3 also enters
+            // first-person view (C-up), as clicking the camera stick does in modern games.
+            BindButton(controller, BTN_CUP, SDL_CONTROLLER_BUTTON_RIGHTSTICK);
             BindButton(controller, BTN_CDOWN, SDL_CONTROLLER_BUTTON_X);
 #else
             BindButton(controller, BTN_CDOWN, SDL_CONTROLLER_BUTTON_B);
-- 
2.43.0

