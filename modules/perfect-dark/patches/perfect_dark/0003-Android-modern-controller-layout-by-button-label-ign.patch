From 477f73e0686c4778bb1ee89ddcf9a3f14c382027 Mon Sep 17 00:00:00 2001
From: plm <plm@localhost>
Date: Thu, 12 Nov 2026 10:47:37 +1100
Subject: [PATCH] Android: modern controller layout by button label; ignore
 saved binds

---
 port/src/input.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/port/src/input.c b/port/src/input.c
index 0adad35c2..4c48716e8 100644
--- a/port/src/input.c
+++ b/port/src/input.c
@@ -214,6 +214,29 @@ void inputSetDefaultKeyBinds(s32 cidx, s32 n64mode)
 		{ CK_CANCEL,        VK_MOUSE_RIGHT,      0                   },
 	};
 
+#ifdef __ANDROID__
+	// Port launcher: one modern layout, bound by button label (SDL names = the labels the controller reports).
+	// A use/confirm, B crouch/back, Y reload, X next weapon, L1 previous weapon, R1 secondary function,
+	// D-pad down weapon wheel, D-pad left/right/up the remaining C buttons.
+	static const u32 pcjoybinds[][2] = {
+		{ CK_A,      SDL_CONTROLLER_BUTTON_A             },
+		{ CK_X,      SDL_CONTROLLER_BUTTON_Y             },
+		{ CK_Y,      SDL_CONTROLLER_BUTTON_X             },
+		{ CK_8000,   SDL_CONTROLLER_BUTTON_B             },
+		{ CK_DPAD_L, SDL_CONTROLLER_BUTTON_LEFTSHOULDER  },
+		{ CK_LTRIG,  SDL_CONTROLLER_BUTTON_RIGHTSHOULDER },
+		{ CK_RTRIG,  VK_JOY1_LTRIG - VK_JOY1_BEGIN       },
+		{ CK_ZTRIG,  VK_JOY1_RTRIG - VK_JOY1_BEGIN       },
+		{ CK_START,  SDL_CONTROLLER_BUTTON_START         },
+		{ CK_DPAD_D, SDL_CONTROLLER_BUTTON_DPAD_DOWN     },
+		{ CK_C_U,    SDL_CONTROLLER_BUTTON_DPAD_UP       },
+		{ CK_C_R,    SDL_CONTROLLER_BUTTON_DPAD_RIGHT    },
+		{ CK_C_L,    SDL_CONTROLLER_BUTTON_DPAD_LEFT     },
+		{ CK_ACCEPT, SDL_CONTROLLER_BUTTON_A             },
+		{ CK_CANCEL, SDL_CONTROLLER_BUTTON_B             },
+		{ CK_8000,   SDL_CONTROLLER_BUTTON_LEFTSTICK     },
+	};
+#else
 	static const u32 pcjoybinds[][2] = {
 		{ CK_A,      SDL_CONTROLLER_BUTTON_A             },
 		{ CK_X,      SDL_CONTROLLER_BUTTON_X             },
@@ -233,6 +256,8 @@ void inputSetDefaultKeyBinds(s32 cidx, s32 n64mode)
 		{ CK_8000,   SDL_CONTROLLER_BUTTON_LEFTSTICK     },
 	};
 
+#endif
+
 	static const u32 n64kbbinds[][3] = {
 		{ CK_A,          SDL_SCANCODE_Q,      0                  },
 		{ CK_B,          SDL_SCANCODE_E,      0                  },
@@ -754,7 +779,9 @@ s32 inputInit(void)
 		inputControllerSetSticksSwapped(i, padsCfg[i].swapSticks);
 	}
 
+#ifndef __ANDROID__
 	inputLoadBinds();
+#endif
 
 	// Explicitly stop text input to prevent key events being swallowed on certain Wayland systems
 	inputStopTextInput();
-- 
2.43.0

