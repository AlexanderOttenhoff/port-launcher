From: plm <plm@localhost>
Date: Thu, 12 Nov 2026 10:57:39 +1100
Subject: [PATCH] Android: hold next weapon for the weapon wheel; pause while
 the wheel is open

---
 src/game/activemenu.c     | 29 +++++++++++++++++++++++
 src/game/activemenutick.c |  4 ++++
 src/game/bondmove.c       | 48 +++++++++++++++++++++++++++++++++++++--
 3 files changed, 79 insertions(+), 2 deletions(-)

diff --git a/src/game/activemenu.c b/src/game/activemenu.c
index e1dde59a7..cd8b740a0 100644
--- a/src/game/activemenu.c
+++ b/src/game/activemenu.c
@@ -730,9 +730,35 @@ void amAssignWeaponSlots(void)
 	}
 }
 
+#ifdef __ANDROID__
+#include <stdlib.h>
+#include "game/lv.h"
+
+// Port launcher gameplay tweak "Pause on weapon wheel" (default on; launch env PLM_PD_WHEEL_PAUSE=0 turns it off).
+// Only with one player: in split screen the others keep playing.
+static bool g_PlmWheelPaused;
+
+static void amPlmPause(bool open)
+{
+	if (open) {
+		const char *opt = getenv("PLM_PD_WHEEL_PAUSE");
+		if ((opt == NULL || opt[0] != '0') && PLAYERCOUNT() == 1 && !lvIsPaused() && !mpIsPaused()) {
+			lvSetPaused(true);
+			g_PlmWheelPaused = true;
+		}
+	} else if (g_PlmWheelPaused) {
+		g_PlmWheelPaused = false;
+		lvSetPaused(false);
+	}
+}
+#endif
+
 void amOpen(void)
 {
 	if (g_Vars.currentplayer->gunctrl.passivemode == false) {
+#ifdef __ANDROID__
+		amPlmPause(true);
+#endif
 		g_AmIndex = g_Vars.currentplayernum;
 		g_Vars.currentplayer->activemenumode = AMMODE_VIEW;
 		g_PlayersWithControl[g_Vars.currentplayernum] = false;
@@ -757,6 +783,9 @@ void amClose(void)
 	g_Vars.currentplayer->activemenumode = AMMODE_CLOSED;
 	g_Vars.currentplayer->joybutinhibit = 0xffffffff;
 	g_PlayersWithControl[g_Vars.currentplayernum] = 1;
+#ifdef __ANDROID__
+	amPlmPause(false);
+#endif
 }
 
 bool amIsCramped(void)
diff --git a/src/game/activemenutick.c b/src/game/activemenutick.c
index 570508ea4..9eabfad3e 100644
--- a/src/game/activemenutick.c
+++ b/src/game/activemenutick.c
@@ -47,7 +47,11 @@ void amTick(void)
 			u32 amask, lrtmask, umask, dmask, lmask, rmask;
 
 			if (controlmode == CONTROLMODE_PC) {
+#ifdef __ANDROID__
+				amask = D_JPAD | BUTTON_WPNFORWARD;
+#else
 				amask = D_JPAD;
+#endif
 				lrtmask = R_TRIG;
 				umask = U_CBUTTONS;
 				dmask = D_CBUTTONS;
diff --git a/src/game/bondmove.c b/src/game/bondmove.c
index 414e3cc1d..a1575ff4b 100644
--- a/src/game/bondmove.c
+++ b/src/game/bondmove.c
@@ -28,6 +28,7 @@
 #include "game/options.h"
 #include "game/propobj.h"
 #include "bss.h"
+
 #include "lib/lib_17ce0.h"
 #include "lib/vi.h"
 #include "lib/collision.h"
@@ -43,6 +44,35 @@
 #include "input.h"
 #include "video.h"
 
+#ifdef __ANDROID__
+// Port launcher: a tap of the next-weapon button switches weapon (on release); holding it opens the weapon
+// wheel, which stays open while held (activemenutick.c) and selects on release.
+static s32 g_PlmWpnHold[MAX_PLAYERS];
+
+static bool bmovePlmWeaponForward(s32 i, s8 contpad, u32 allowed, struct movedata *data)
+{
+	s32 *hold = &g_PlmWpnHold[g_Vars.currentplayernum];
+
+	if (joyGetButtonsOnSample(i, contpad, allowed & BUTTON_WPNFORWARD)) {
+		if (*hold >= 0 && ++*hold > TICKS(15)) {
+			amOpen();
+			*hold = -1;
+		}
+		return false;
+	}
+
+	if (*hold > 0) {
+		*hold = 0;
+		data->weaponforwardoffset++;
+		return true;
+	}
+
+	*hold = 0;
+	return false;
+}
+#endif
+
+
 static void bgunProcessQuickDetonate(struct movedata *data, u32 c1buttons, u32 c1buttonsthisframe, u32 buttons1, u32 buttons2) {
 	if ((((c1buttons & (buttons1)) && (c1buttonsthisframe & (buttons2)))
 			|| ((c1buttons & (buttons2)) && (c1buttonsthisframe & (buttons1))))
@@ -1025,10 +1055,17 @@ void bmoveProcessInput(bool allowc1x, bool allowc1y, bool allowc1buttons, bool i
 						} else {
 							for (i = 0; i < numsamples; i++) {
 								if (controlmode == CONTROLMODE_PC) {
+#ifdef __ANDROID__
+									if (bmovePlmWeaponForward(i, contpad1, c1allowedbuttons, &movedata)) {
+										g_Vars.currentplayer->invdowntime = -1;
+									} else if
+#else
 									if (joyGetButtonsPressedOnSample(i, contpad1, c1allowedbuttons & BUTTON_WPNFORWARD)) {
 										movedata.weaponforwardoffset++;
 										g_Vars.currentplayer->invdowntime = -1;
-									} else if (joyGetButtonsPressedOnSample(i, contpad1, c1allowedbuttons & BUTTON_WPNBACK)) {
+									} else if
+#endif
+										(joyGetButtonsPressedOnSample(i, contpad1, c1allowedbuttons & BUTTON_WPNBACK)) {
 										movedata.weaponbackoffset++;
 										g_Vars.currentplayer->invdowntime = -1;
 									}
@@ -1486,10 +1523,17 @@ void bmoveProcessInput(bool allowc1x, bool allowc1y, bool allowc1buttons, bool i
 							for (i = 0; i < numsamples; i++) {
 #ifndef PLATFORM_N64
 								if (controlmode == CONTROLMODE_PC) {
+#ifdef __ANDROID__
+									if (bmovePlmWeaponForward(i, contpad1, c1allowedbuttons, &movedata)) {
+										g_Vars.currentplayer->invdowntime = -1;
+									} else if
+#else
 									if (joyGetButtonsPressedOnSample(i, contpad1, c1allowedbuttons & BUTTON_WPNFORWARD)) {
 										movedata.weaponforwardoffset++;
 										g_Vars.currentplayer->invdowntime = -1;
-									} else if (joyGetButtonsPressedOnSample(i, contpad1, c1allowedbuttons & BUTTON_WPNBACK)) {
+									} else if
+#endif
+										(joyGetButtonsPressedOnSample(i, contpad1, c1allowedbuttons & BUTTON_WPNBACK)) {
 										movedata.weaponbackoffset++;
 										g_Vars.currentplayer->invdowntime = -1;
 									}
