From 246c08df9976c24e35c4283503d1d0d3a0e594b2 Mon Sep 17 00:00:00 2001
From: Alexander Ottenhoff <AlexanderOttenhoff@users.noreply.github.com>
Date: Fri, 13 Nov 2026 12:59:50 +1100
Subject: [PATCH 1/2] Android: shared library, no host soh.o2r step; no Run SoH
 prompt after a launcher's extraction (PLM_ROM)

---
 CMakeLists.txt         | 4 ++++
 soh/CMakeLists.txt     | 7 ++++++-
 soh/soh/OTRGlobals.cpp | 6 ++++++
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index eb3c38752..5348c12f8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -334,6 +334,9 @@ add_custom_target(
     COMMAND ${CMAKE_COMMAND} -E false
 )
 
+# Android cross builds can't run the packer (a host tool); port-launcher packs soh.o2r with a host build of the
+# tools-only configure (SOH_TOOLS_ONLY) instead.
+if(NOT ANDROID)
 # soh.o2r is rebuilt only when its inputs change, and is part of ALL so `install` never ships a stale one.
 file(GLOB_RECURSE SOH_O2R_ASSETS CONFIGURE_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/soh/assets/custom/*)
 list(FILTER SOH_O2R_ASSETS EXCLUDE REGEX "/soh/assets/custom/shaders/")
@@ -358,6 +361,7 @@ add_custom_target(GenerateSohOtr ALL DEPENDS ${CMAKE_BINARY_DIR}/soh/soh.o2r)
 
 # ExtractAssets produced soh.o2r as well as the rom archives, so keep doing that.
 add_dependencies(ExtractAssets GenerateSohOtr)
+endif()
 
 # The asset tools only need torch, so a tools-only configure can skip libultraship and soh
 # entirely -- that is all CI needs to produce soh.o2r.
diff --git a/soh/CMakeLists.txt b/soh/CMakeLists.txt
index f356d2148..5b846d67b 100644
--- a/soh/CMakeLists.txt
+++ b/soh/CMakeLists.txt
@@ -226,7 +226,12 @@ set(ALL_FILES
 ################################################################################
 # Target
 ################################################################################
-add_executable(${PROJECT_NAME} ${ALL_FILES})
+if(ANDROID)
+    # The game is a shared library that an SDL Java activity (here: the port launcher's host) loads.
+    add_library(${PROJECT_NAME} SHARED ${ALL_FILES})
+else()
+    add_executable(${PROJECT_NAME} ${ALL_FILES})
+endif()
 
 if (CMAKE_SYSTEM_NAME STREQUAL "Windows")
 use_props(${PROJECT_NAME} "${CMAKE_CONFIGURATION_TYPES}" "${DEFAULT_CXX_PROPS}")
diff --git a/soh/soh/OTRGlobals.cpp b/soh/soh/OTRGlobals.cpp
index 79a804b99..d93dbdda5 100644
--- a/soh/soh/OTRGlobals.cpp
+++ b/soh/soh/OTRGlobals.cpp
@@ -591,6 +591,12 @@ void OTRGlobals::RunExtract(int argc, char* argv[]) {
             }
             case ES_EXTRACT_ARGS: {
 #if !defined(__SWITCH__) && !defined(__WIIU__)
+                // A launcher that passed the ROM (port-launcher sets PLM_ROM and passes it as the argument while
+                // oot.o2r is missing) starts the game right after extracting: no "Run SoH?" prompt in direct boot.
+                if (const char* launcherRom = std::getenv("PLM_ROM"); args.empty() && launcherRom != nullptr && *launcherRom) {
+                    extractStep = ES_VERIFY;
+                    continue;
+                }
                 if (args.empty()) {
                     SohGui::RegisterPopup(
                         "Run Ship of Harkinian", "All files have been processed. Run SoH?", "Yes", "No",
-- 
