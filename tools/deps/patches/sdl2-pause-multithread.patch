+/* port-launcher (sleep/wake fix, 2026-11-16): SDL assumes one thread pumps events. Ports that pump on two
+ * (GoldenEye: its main loop and its render thread both call SDL_PollEvent) both saw the shared isPaused flag and
+ * both blocked in SDL_SemWait(Android_ResumeSem), but nativeResume posts that semaphore once: one thread woke, the
+ * other stayed blocked until the next pause/resume (Home and reopen), so after a lock screen the game thread
+ * produced nothing. Now one thread owns the wait (it consumes the resume signal, sends the app events and pauses or
+ * resumes audio) and every other pumping thread follows it: it releases its GL context like the owner, sleeps until
+ * the owner's resume generation changes, then restores its own context. A follower takes over ownership if nobody
+ * holds it, so a thread can never wait for an owner that isn't coming. The plm-pause log lines show who did what. */
+static SDL_atomic_t plm_pause_owner;      /* 1 while a thread is blocked in SDL_SemWait(Android_ResumeSem) */
+static SDL_atomic_t plm_resume_generation; /* bumped by the owner after each resume (after isPaused = 0) */
+
+static void plm_egl_backup(SDL_bool isContextExternal)
+{
+#ifdef SDL_VIDEO_OPENGL_EGL
+    if (!isContextExternal) {
+        SDL_LockMutex(Android_ActivityMutex);
+        android_egl_context_backup(Android_Window);
+        SDL_UnlockMutex(Android_ActivityMutex);
+    }
+#endif
+}
+
+static void plm_egl_restore(SDL_bool isContextExternal)
+{
+#ifdef SDL_VIDEO_OPENGL_EGL
+    if (!isContextExternal && !SDL_HasEvent(SDL_QUIT)) {
+        SDL_LockMutex(Android_ActivityMutex);
+        android_egl_context_restore(Android_Window);
+        SDL_UnlockMutex(Android_ActivityMutex);
+    }
+#endif
+}
+
+/* Waits until the owner has resumed, or takes over the wait when nobody owns it (then *become_owner is set). */
+static void plm_follow_pause(SDL_VideoData *videodata, int generation, SDL_bool *become_owner)
+{
+    int waited_ms = 0;
+    *become_owner = SDL_FALSE;
+    __android_log_print(ANDROID_LOG_INFO, "SDL", "plm-pause: tid %d follows the paused owner", (int)gettid());
+    for (;;) {
+        SDL_MemoryBarrierAcquire();
+        if (SDL_AtomicGet(&plm_resume_generation) != generation || !videodata->isPaused) {
+            break;
+        }
+        if (SDL_AtomicCAS(&plm_pause_owner, 0, 1)) {
+            *become_owner = SDL_TRUE;
+            __android_log_print(ANDROID_LOG_INFO, "SDL", "plm-pause: tid %d took over the wait", (int)gettid());
+            return;
+        }
+        SDL_Delay(5);
+        waited_ms += 5;
+    }
+    __android_log_print(ANDROID_LOG_INFO, "SDL", "plm-pause: tid %d resumed after the owner (%d ms)",
+                        (int)gettid(), waited_ms);
+}
